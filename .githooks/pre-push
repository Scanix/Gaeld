#!/bin/sh
#
# Pre-push hook: runs Pint and PHPStan before pushing to production.
# Prevents pushing code that would fail CI lint/analyse stages.
#

REMOTE="$1"
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Only enforce on pushes to production
if [ "$BRANCH" != "production" ]; then
    exit 0
fi

echo "🔒 Pushing to production — running pre-push checks..."
echo ""

# 0. Drift guard: production must only differ from CE main in deploy-specific files.
# Uses origin/main (GitHub CE) as the reference — gitlab/main is the production
# remote and intentionally differs, so it must never be used for this check.
echo "🔍 [0/2] Checking production has no unreleased app code..."
git fetch origin main --quiet 2>/dev/null || true
UNEXPECTED=$(git diff origin/main HEAD --name-only -- . ':!deploy.php' ':!INSTALL.md' 2>/dev/null | wc -l | tr -d ' ')
if [ "$UNEXPECTED" -gt 0 ]; then
    echo ""
    echo "❌ Production has $UNEXPECTED file(s) with changes not in CE main (origin/main):"
    git diff origin/main HEAD --name-only -- . ':!deploy.php' ':!INSTALL.md'
    echo "   Merge your changes to main first, then re-merge main → production."
    echo "   Push to production aborted."
    exit 1
fi
echo "✅ Production content matches CE main (only deploy-specific files differ)."
echo ""

# 1. Pint (code style)
echo "🔍 [1/3] Running Pint..."
./vendor/bin/pint --test
PINT_EXIT=$?

if [ $PINT_EXIT -ne 0 ]; then
    echo ""
    echo "❌ Pint found code style issues. Run 'composer format' to fix them."
    echo "   Push to production aborted."
    exit 1
fi

echo "✅ Pint passed."
echo ""

# 3. PHPStan (static analysis)
echo "🔍 [2/3] Running PHPStan..."
./vendor/bin/phpstan analyse --memory-limit=512M --no-progress
PHPSTAN_EXIT=$?

if [ $PHPSTAN_EXIT -ne 0 ]; then
    echo ""
    echo "❌ PHPStan found errors. Fix them before pushing to production."
    echo "   Push to production aborted."
    exit 1
fi

echo ""
echo "✅ All 3 pre-push checks passed. Pushing to production..."
exit 0
