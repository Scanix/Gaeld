[Unit]
Description=Gaeld dedicated PHP-FPM
After=network.target postgresql.service redis-server.service
[Service]
Type=simple
ExecStart=/usr/sbin/php-fpm8.4 --fpm-config @ROOT@/.gaeld/fpm.conf --nodaemonize
KillSignal=SIGQUIT
TimeoutStopSec=2100
Restart=on-failure
[Install]
WantedBy=multi-user.target
