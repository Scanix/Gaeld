# Only production source enters a build context. Local data, caches, secrets,
# private plugins and QA artifacts must never become public image layers.
**
!.dockerignore
!app/
!app/**
!artisan
!bootstrap/
!bootstrap/**
bootstrap/cache/*.php
!config/
!config/**
!contract/
!contract/**
!database/
!database/**
!docker/
!docker/**
docker/nginx/default.conf
docker/supervisor/gaeld-worker.conf
docker/systemd/gaeld-worker.service
!lang/
!lang/**
!public/
!public/**
public/build/
public/storage/
public/hot
!resources/
!resources/**
resources/js/Pages/SaasAdmin/
resources/js/Components/SaasAdmin/
!routes/
!routes/**
!scripts/
scripts/**
!scripts/distribution/
!scripts/distribution/**
!docs/
docs/**
!docs/ce-managed-installation.md
!docs/preservation-r2.md
!composer.json
!.env.example
!.env.production.example
!composer.lock
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!vite.config.js
!tailwind.config.js
!docker-compose.yml
!gaeld
!LICENSE
!README.md
!INSTALL.md
!RELEASE.md
!CHANGELOG.md
!SECURITY.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
**/__pycache__/
**/*.pyc
**/.env*
**/auth.json
!.env.example
!.env.production.example
